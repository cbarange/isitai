# Secrets: never commit
.env
.env.*
*.pem
# Public C2PA trust list, embedded in the core crate (not a secret)
!crates/isitai-core/trust/C2PA-TRUST-LIST.pem
.npmrc*

# Build outputs
/target
**/target/
dist/
*.node
bindings/node/native.js
bindings/node/native.d.ts
bindings/node/npm/

# Tooling
node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store
*.so
*.pyd
*.dylib
# Copied from the root README at build time
bindings/*/README.md

# WebAssembly engine of the demo page, built by site/build.sh
site/pkg/
